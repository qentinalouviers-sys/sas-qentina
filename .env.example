# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (scanner IA, banque, Fuego, audits) ───────────
ANTHROPIC_API_KEY=

# ── Square ──────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Secret de signature du webhook (Square Developer Dashboard → Webhooks)
SQUARE_WEBHOOK_SECRET=

# ── Application ─────────────────────────────────────────────
# URL publique, SANS barre oblique finale. Obligatoire en production.
# Elle sert à vérifier la signature des webhooks Square et à construire la
# redirection OAuth Google : elle doit être IDENTIQUE au caractère près dans
# Vercel, dans le Square Developer Dashboard et dans la Google Cloud Console.
# Sur Vercel, à défaut, l'app se rabat sur VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google (avis) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Synchronisation automatique (Vercel Cron) ───────────────
# Secret partagé qui authentifie les appels du planificateur.
# Vercel ajoute automatiquement l'en-tête « Authorization: Bearer $CRON_SECRET »
# à ses requêtes DÈS LORS que cette variable est définie.
# Sans elle, /api/cron/square-sync REFUSE de travailler (503) plutôt que de
# rester ouverte : c'est une route qui écrit en base et appelle l'API Square.
# Générer une valeur longue et aléatoire, par exemple :  openssl rand -hex 32
CRON_SECRET=
