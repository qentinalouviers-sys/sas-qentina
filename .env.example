# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clés IA ─────────────────────────────────────────────────
# Ces clés peuvent aussi se saisir dans Réglages → Moteurs IA, ce qui évite
# un redéploiement. La base l'emporte ; ces variables restent en repli, pour
# ne jamais se retrouver enfermé dehors (base vidée, premier démarrage).
#
# Clé maître qui chiffre les clés enregistrées en base. Obligatoire pour
# utiliser l'écran Réglages → Moteurs IA. À générer UNE FOIS :
#   openssl rand -hex 32
# Ne plus la changer ensuite : les clés déjà enregistrées deviendraient
# illisibles et il faudrait les ressaisir.
SETTINGS_ENCRYPTION_KEY=

# Anthropic — banque, Fuego, audits, chat. Toujours nécessaire :
# seul l'OCR des factures peut passer sur Gemini.
ANTHROPIC_API_KEY=

# Google Gemini — OCR des factures.
# Clé à créer sur https://aistudio.google.com/apikey
# Dès qu'elle est disponible, l'OCR bascule automatiquement sur Gemini.
GEMINI_API_KEY=

# Moteur d'OCR : « gemini » ou « anthropic ».
# Réglable aussi depuis Réglages → Moteurs IA.
# Vide = Gemini si une clé Google existe, sinon Claude.
OCR_PROVIDER=

# Modèle Gemini. Vide = gemini-2.5-flash.
# Pour connaître les modèles ouverts à votre clé :
#   curl -H "x-goog-api-key: VOTRE_CLE" \
#        "https://generativelanguage.googleapis.com/v1beta/models"
GEMINI_MODEL=

# Budget de « raisonnement » Gemini, facturé comme de la sortie.
# 0 = désactivé, c'est le réglage recherché pour de l'extraction structurée.
# À remonter (ex. 128) seulement si un modèle refuse la valeur 0.
GEMINI_THINKING_BUDGET=0

# ── Square ──────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Secret de signature du webhook (Square Developer Dashboard → Webhooks)
SQUARE_WEBHOOK_SECRET=

# ── Application ─────────────────────────────────────────────
# URL publique, SANS barre oblique finale. Obligatoire en production.
# Elle sert à vérifier la signature des webhooks Square et à construire la
# elle doit être IDENTIQUE au caractère près dans Vercel et dans le Square
# Developer Dashboard.
# Sur Vercel, à défaut, l'app se rabat sur VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Synchronisation automatique (Vercel Cron) ───────────────
# Secret partagé qui authentifie les appels du planificateur.
# Vercel ajoute automatiquement l'en-tête « Authorization: Bearer $CRON_SECRET »
# à ses requêtes DÈS LORS que cette variable est définie.
# Sans elle, /api/cron/square-sync REFUSE de travailler (503) plutôt que de
# rester ouverte : c'est une route qui écrit en base et appelle l'API Square.
# Générer une valeur longue et aléatoire, par exemple :  openssl rand -hex 32
CRON_SECRET=
